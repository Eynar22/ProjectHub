# Plantilla de variables de entorno del backend NestJS. Copiar a backend/.env
# (dev local) o cargarlas en el panel de Dokploy (producción). NUNCA commitear .env.

# ── Base de datos ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:12345@postgres:5432/buscador

# ── Auth / API ──────────────────────────────────────────────────────────────
JWT_SECRET=super_secret_key_123
PORT=3000
CORS_ORIGINS=https://projecthub.umaunivalle.com,http://localhost:5173
TZ=UTC

# ── Almacenamiento de archivos en disco ─────────────────────────────────────
# Carpeta DENTRO del contenedor donde se escriben los archivos. Debe coincidir
# con el destino del volumen en docker-compose.yml.
ALMACENAMIENTO_DIR=/app/almacenamiento

# Tope de uso en bytes. Al superarlo, las subidas responden 507. 55 GiB por
# defecto (~28% de un disco de 192 GB, deja margen sobre el objetivo del 30%).
ALMACENAMIENTO_MAX_BYTES=59055800320

# Ruta EN EL HOST que se monta como volumen (solo la lee docker-compose, no el
# código). En Dokploy: ../files/almacenamiento (queda incluida en los backups).
# En dev, si se omite, docker-compose usa ./almacenamiento_data.
ALMACENAMIENTO_HOST_PATH=../files/almacenamiento
