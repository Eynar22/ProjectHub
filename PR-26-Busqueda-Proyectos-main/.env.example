# Plantilla de variables de entorno (Anexo B10). Copiar a .env.local y ajustar.
# En Vite, toda variable expuesta al navegador DEBE empezar con VITE_.
# NUNCA pongas secretos aquí: el prefijo VITE_ queda visible en el bundle.

# URL base del backend NestJS, sin barra final ni sufijo /api.
# Si se deja vacía, el frontend usa http://localhost:3000/api en desarrollo
# y /api (proxy de nginx) en producción.
VITE_API_URL=http://localhost:3000

# Nombre visible de la aplicación.
VITE_APP_NOMBRE=ProjectHub

# Logs detallados en consola (solo desarrollo).
VITE_DEBUG=false
